# ── Required in production ───────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, a VPS…). Migrations and the
# initial seed run automatically on first start.
DATABASE_URL=postgres://user:password@host:5432/neelaryan

# Public address of the customer site. Table QR codes and unsubscribe links point here,
# so set it BEFORE printing QR codes. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://order.your-cafe.in

# First Super Admin account, created once on first start. The password must be
# changed at the first sign-in (the app forces it). Change these defaults.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=welcome@2026

# Protects the scheduler endpoint (/api/cron): due campaigns, birthday messages,
# points expiry and the send queue. Any long random string.
CRON_SECRET=

# ── SMS & WhatsApp (Twilio) — sign-in codes, offers, birthday wishes ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sending number (E.164) or a Messaging Service SID:
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp-enabled sender (E.164). Business-initiated WhatsApp needs Meta-approved templates.
TWILIO_WHATSAPP_FROM=
# Country code added to 10-digit mobile numbers.
DEFAULT_COUNTRY_CODE=+91
# Set to "off" to skip Twilio delivery-status callbacks (they need a public https URL).
TWILIO_STATUS_CALLBACK=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "NEELARYAN Café <hello@your-cafe.in>"
EMAIL_FROM=

# ── Local development only ───────────────────────────────────────────────────
# Without DATABASE_URL, development uses an embedded Postgres (PGlite) stored in .data/pglite.
# PGLITE_DIR=.data/pglite
# Production refuses to start without DATABASE_URL unless you explicitly allow the embedded DB:
# ALLOW_EMBEDDED_DB=1
# Max connections in the pg pool (default 10)
# DATABASE_POOL_MAX=10
