# ── Supabase (required in production) ────────────────────────────────────────
# Supabase dashboard → Connect → Connection string. Use the "Session pooler" string for a
# normal Node server, or the "Transaction pooler" (port 6543) on serverless hosts like Vercel.
# Migrations, the seed and the security lockdown run automatically on first start.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: Supabase dashboard → Database → Settings → SSL certificate (PEM, \n for newlines).
# With it the database certificate is verified; without it the connection is still encrypted.
DATABASE_CA_CERT=

# Supabase Storage for menu photos (server only — NEVER expose the service role key to browsers,
# never prefix it with NEXT_PUBLIC_). Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket created automatically on the first upload.
SUPABASE_STORAGE_BUCKET=menu-images

# Public address of the customer site. Table QR codes and unsubscribe links point here,
# so set it BEFORE printing QR codes. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://order.your-cafe.in

# First Super Admin account, created once on first start. The password must be
# changed at the first sign-in (the app forces it). Change these defaults.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=welcome@2026

# Protects the scheduler endpoint (/api/cron): due campaigns, birthday messages,
# points expiry and the send queue. Any long random string.
CRON_SECRET=

# ── SMS & WhatsApp (Twilio) — sign-in codes, offers, birthday wishes ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sending number (E.164) or a Messaging Service SID:
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp-enabled sender (E.164). Business-initiated WhatsApp needs Meta-approved templates.
TWILIO_WHATSAPP_FROM=
# Country code added to 10-digit mobile numbers.
DEFAULT_COUNTRY_CODE=+91
# Set to "off" to skip Twilio delivery-status callbacks (they need a public https URL).
TWILIO_STATUS_CALLBACK=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "NEELARYAN Café <hello@your-cafe.in>"
EMAIL_FROM=

# ── Local development only ───────────────────────────────────────────────────
# Without DATABASE_URL, development uses an embedded Postgres (PGlite) stored in .data/pglite,
# and photos are kept in the database instead of Supabase Storage.
# PGLITE_DIR=.data/pglite
# Production refuses to start without DATABASE_URL unless you explicitly allow the embedded DB:
# ALLOW_EMBEDDED_DB=1
# Max connections in the pg pool (default 10)
# DATABASE_POOL_MAX=10

# Web push (order-ready alerts for guests, lock-screen alerts for staff).
# Generate once: npx web-push generate-vapid-keys   — leave empty to hide the alert buttons.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
